# Project-local PostgreSQL credentials. Never commit the populated .env file.
POSTGRES_PASSWORD=replace-with-a-local-password

# Use the Ollama instance running on the Docker host; do not add Ollama to Compose.
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.2:latest
OLLAMA_TIMEOUT_SECONDS=90
OLLAMA_RETRIES=2

# Optional OpenWebUI provider. Leave the URL empty to disable discovery.
OPENWEBUI_BASE_URL=
OPENWEBUI_API_KEY=
OPENWEBUI_TIMEOUT_SECONDS=90

# Initial provider/model fallback. The Research Admin console can select exact models.
AI_PROVIDER=ollama
AI_MODEL=

# Required for research submission, review, publication, and knowledge-base mutations.
ADMIN_API_KEY=replace-with-a-long-random-admin-key

# Optional comma-separated service credentials for proposal submission only.
# These credentials cannot review or publish knowledge.
KNOWLEDGE_INTEGRATION_KEYS=replace-with-scoped-service-key
KNOWLEDGE_PROPOSAL_RATE_LIMIT_PER_MINUTE=30
KNOWLEDGE_EXCERPT_MAX_CHARS=6000

# Research and URL-import safety limits.
MAX_RESEARCH_BYTES=500000
URL_IMPORT_TIMEOUT_SECONDS=10
URL_IMPORT_MAX_BYTES=1000000
URL_IMPORT_MAX_REDIRECTS=5
RESEARCH_REQUEST_TIMEOUT_SECONDS=15
RESEARCH_RESPONSE_MAX_BYTES=1000000
RESEARCH_RETRY_COUNT=2
RESEARCH_RETRY_BASE_SECONDS=1
RESEARCH_MAX_ITEMS_PER_RUN=50
RESEARCH_SCHEDULER_ENABLED=true
RESEARCH_SCHEDULER_POLL_SECONDS=30
RESEARCH_LOCK_TTL_SECONDS=900
RESEARCH_ALLOWED_USER_AGENT=CyberSecCareerIntelligenceResearch/1.0
RESEARCH_DEFAULT_RESPECT_ROBOTS=true

# Optional permitted job-search integrations. Leave empty to use import-only mode.
LINKEDIN_AUTHORIZED_API_BASE_URL=
LINKEDIN_AUTHORIZED_API_KEY=
LICENSED_JOB_PROVIDER_BASE_URL=
LICENSED_JOB_PROVIDER_API_KEY=
EMPLOYER_ATS_API_BASE_URL=
EMPLOYER_ATS_API_KEY=

# Official JSearch API via RapidAPI. Keep the key backend-only.
JSEARCH_API_KEY=
JSEARCH_API_HOST=jsearch.p.rapidapi.com
JSEARCH_API_ENDPOINT=https://jsearch.p.rapidapi.com/search-v2
JSEARCH_JOB_DETAILS_ENDPOINT=https://jsearch.p.rapidapi.com/job-details
JSEARCH_TIMEOUT_SECONDS=15
JSEARCH_MAX_REQUESTS_PER_RUN=10
JSEARCH_MAX_RESULTS_PER_RUN=100
JSEARCH_MAX_PAGES_PER_RUN=3
JSEARCH_RETRY_COUNT=2
JSEARCH_RETRY_BASE_SECONDS=1
JSEARCH_RATE_LIMIT_SLEEP_SECONDS=2

# Yahoo Mail LinkedIn Job Alerts (backend-only IMAP over TLS)
MAIL_ENCRYPTION_KEY=
YAHOO_IMAP_HOST=imap.mail.yahoo.com
YAHOO_IMAP_PORT=993
MAIL_SYNC_MAX_MESSAGES=100
MAIL_MAX_MESSAGE_BYTES=2000000
MAIL_MAX_CANDIDATES_PER_MESSAGE=50
MAIL_DEFAULT_SYNC_INTERVAL_MINUTES=360
MAIL_CANDIDATE_RETENTION_DAYS=90
JOB_SEARCH_RETENTION_DAYS=90

