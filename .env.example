# Project-local PostgreSQL credentials. Never commit the populated .env file.
POSTGRES_PASSWORD=replace-with-a-local-password

# Use the Ollama instance running on the Docker host; do not add Ollama to Compose.
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.2:latest
OLLAMA_TIMEOUT_SECONDS=90
OLLAMA_RETRIES=2

# Optional OpenWebUI provider. Leave the URL empty to disable discovery.
OPENWEBUI_BASE_URL=
OPENWEBUI_API_KEY=
OPENWEBUI_TIMEOUT_SECONDS=90

# Initial provider/model fallback. The Research Admin console can select exact models.
AI_PROVIDER=ollama
AI_MODEL=

# Required for research submission, review, publication, and knowledge-base mutations.
ADMIN_API_KEY=replace-with-a-long-random-admin-key

# Research and URL-import safety limits.
MAX_RESEARCH_BYTES=500000
URL_IMPORT_TIMEOUT_SECONDS=10
URL_IMPORT_MAX_BYTES=1000000
URL_IMPORT_MAX_REDIRECTS=5

